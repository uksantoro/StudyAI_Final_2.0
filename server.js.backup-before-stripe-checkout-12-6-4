app.post("/api/review/result",auth,(req,res)=>{
  try{
    const {itemType,itemId,result}=req.body||{};

    if(!["flashcard"].includes(String(itemType))){
      return res.status(400).json({error:"Tipo di elemento non valido."});
    }

    if(!["remembered","forgot"].includes(String(result))){
      return res.status(400).json({error:"Risultato non valido."});
    }

    const item=db.prepare(`
      SELECT
        f.id,
        f.lesson_id
      FROM flashcards f
      JOIN lessons l ON l.id=f.lesson_id
      JOIN subjects s ON s.id=l.subject_id
      JOIN courses c ON c.id=s.course_id
      WHERE f.id=?
        AND c.user_id=?
    `).get(Number(itemId),req.user.id);

    if(!item){
      return res.status(404).json({error:"Flashcard non trovata."});
    }

    const current=db.prepare(`
      SELECT *
      FROM review_progress
      WHERE user_id=?
        AND item_type='flashcard'
        AND item_id=?
    `).get(req.user.id,item.id);

    let repetitions=Number(current?.repetitions||0);
    let intervalDays=Number(current?.interval_days||0);
    let ease=Number(current?.ease||2.5);

    if(result==="forgot"){
      repetitions=0;
      intervalDays=1;
      ease=Math.max(1.3,ease-0.2);
    }else{
      repetitions+=1;
      ease=Math.min(3.0,ease+0.1);

      const intervals=[1,3,7,14,30];
      intervalDays=intervals[Math.min(repetitions-1,intervals.length-1)];
    }

    const nextReview=new Date(Date.now()+intervalDays*24*60*60*1000)
      .toISOString()
      .slice(0,19)
      .replace("T"," ");

    db.prepare(`
      INSERT INTO review_progress(
        user_id,
        lesson_id,
        item_type,
        item_id,
        repetitions,
        interval_days,
        ease,
        last_result,
        next_review_at,
        updated_at
      )
      VALUES(?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP)
      ON CONFLICT(user_id,item_type,item_id)
      DO UPDATE SET
        repetitions=excluded.repetitions,
        interval_days=excluded.interval_days,
        ease=excluded.ease,
        last_result=excluded.last_result,
        next_review_at=excluded.next_review_at,
        updated_at=CURRENT_TIMESTAMP
    `).run(
      req.user.id,
      item.lesson_id,
      "flashcard",
      item.id,
      repetitions,
      intervalDays,
      ease,
      result,
      nextReview
    );

    db.prepare(`
      INSERT INTO study_events(user_id,lesson_id,kind)
      VALUES(?,?,?)
    `).run(
      req.user.id,
      item.lesson_id,
      result==="remembered" ? "review_remembered" : "review_forgot"
    );

    res.json({
      ok:true,
      itemId:item.id,
      result,
      repetitions,
      intervalDays,
      nextReview
    });
  }catch(err){
    console.error("REVIEW RESULT ERROR:",err);
    res.status(500).json({error:"Errore nel salvataggio del risultato."});
  }
});
