app.post("/api/ai/transcript",auth,async(req,res)=>{
  try{
    const { lessonId } = req.body || {};
    const id = Number(lessonId);

    if(!Number.isInteger(id) || id <= 0){
      return res.status(400).json({error:"lessonId non valido."});
    }

    const l=getLessonForUser(id,req.user.id);

    if(!l){
      return res.status(404).json({error:"Lezione non trovata."});
    }

    if(!l.audio_path){
      return res.status(400).json({
        error:"Carica prima un file audio o registra una lezione."
      });
    }

    const quota=checkAIQuota(req.user.id,"TRANSCRIPT",1);

    if(!quota.allowed){
      return res.status(429).json({
        error:quota.reason,
        usage:quota
      });
    }

    if(!process.env.OPENAI_API_KEY){
      return res.status(503).json({
        error:"Speech-to-Text non configurato: manca OPENAI_API_KEY."
      });
    }

    const audioPath=path.join(__dirname,l.audio_path);

    if(!fs.existsSync(audioPath)){
      return res.status(404).json({
        error:"File audio non trovato sul server."
      });
    }

    const audioBuffer = fs.readFileSync(audioPath);
    const ext = path.extname(audioPath).toLowerCase();

    const mimeMap = {
      ".mp3": "audio/mpeg",
      ".wav": "audio/wav",
      ".m4a": "audio/mp4",
      ".ogg": "audio/ogg",
      ".webm": "audio/webm"
    };

    const mimeType = mimeMap[ext] || "application/octet-stream";

    const form = new FormData();
    form.append(
      "file",
      new Blob([audioBuffer], { type: mimeType }),
      path.basename(audioPath)
    );
    form.append(
      "model",
      process.env.OPENAI_STT_MODEL || "gpt-4o-mini-transcribe"
    );

    const openaiResponse = await fetch(
      "https://api.openai.com/v1/audio/transcriptions",
      {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${process.env.OPENAI_API_KEY}`
        },
        body: form
      }
    );

    const openaiData = await openaiResponse.json();

    if(!openaiResponse.ok){
      console.error("OPENAI STT ERROR:", openaiData);

      return res.status(502).json({
        error:
          openaiData?.error?.message ||
          "Errore del provider Speech-to-Text."
      });
    }

    const transcript = String(openaiData?.text || "").trim();

    if(!transcript){
      return res.status(502).json({
        error:"Speech-to-Text non ha restituito una trascrizione."
      });
    }

    db.prepare(`
      UPDATE lessons
      SET transcript = ?
      WHERE id = ?
    `).run(transcript, l.id);

    recordAIUsage(req.user.id,"TRANSCRIPT",1);

    const usage={
      feature:"TRANSCRIPT",
      used:quota.used+1,
      limit:quota.limit,
      remaining:Math.max(0,quota.remaining-1),
      plan:quota.plan
    };

    return res.json({
      transcript,
      usage
    });
  }catch(err){
    console.error("AI TRANSCRIPT ERROR:",err);

    res.status(500).json({
      error:"Errore interno del Transcript AI."
    });
  }
});
