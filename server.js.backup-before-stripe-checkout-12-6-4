app.get("/api/progress",auth,(req,res)=>{
  try{
    const userId=req.user.id;

    const review=db.prepare(
      "SELECT COUNT(*) AS total, " +
      "SUM(CASE WHEN last_result='remembered' THEN 1 ELSE 0 END) AS remembered, " +
      "SUM(CASE WHEN last_result='forgot' THEN 1 ELSE 0 END) AS forgot, " +
      "SUM(CASE WHEN next_review_at IS NULL OR next_review_at <= datetime('now') THEN 1 ELSE 0 END) AS due_today " +
      "FROM review_progress WHERE user_id=? AND item_type='flashcard'"
    ).get(userId);

    const lessons=db.prepare(
      "SELECT COUNT(DISTINCT l.id) AS total, " +
      "COUNT(DISTINCT CASE WHEN EXISTS(" +
      "SELECT 1 FROM study_events se WHERE se.user_id=? AND se.lesson_id=l.id" +
      ") THEN l.id END) AS active " +
      "FROM lessons l " +
      "JOIN subjects s ON s.id=l.subject_id " +
      "JOIN courses c ON c.id=s.course_id " +
      "WHERE c.user_id=?"
    ).get(userId,userId);

    const weekly=db.prepare(
      "SELECT date(created_at,'localtime') AS day, COUNT(*) AS total " +
      "FROM study_events " +
      "WHERE user_id=? AND date(created_at,'localtime') >= date('now','localtime','-6 days') " +
      "GROUP BY date(created_at,'localtime') " +
      "ORDER BY day ASC"
    ).all(userId);

    const studyTime=db.prepare(
      "SELECT " +
      "COALESCE(SUM(seconds),0) AS total_seconds, " +
      "COALESCE(SUM(CASE WHEN date(started_at,'localtime')=date('now','localtime') THEN seconds ELSE 0 END),0) AS today_seconds " +
      "FROM study_sessions " +
      "WHERE user_id=?"
    ).get(userId);

    const studyTimeWeekly=db.prepare(
      "SELECT " +
      "date(started_at,'localtime') AS day, " +
      "SUM(seconds) AS seconds " +
      "FROM study_sessions " +
      "WHERE user_id=? " +
      "AND date(started_at,'localtime') >= date('now','localtime','-6 days') " +
      "GROUP BY date(started_at,'localtime') " +
      "ORDER BY day ASC"
    ).all(userId);

    const totalStudySeconds=Number(studyTime?.total_seconds||0);
    const todayStudySeconds=Number(studyTime?.today_seconds||0);

    const activeStudyDays=db.prepare(
      "SELECT COUNT(DISTINCT date(started_at,'localtime')) AS total " +
      "FROM study_sessions " +
      "WHERE user_id=?"
    ).get(userId);

    const studyDays=Number(activeStudyDays?.total||0);

    const averageStudySeconds=studyDays
      ? Math.round(totalStudySeconds/studyDays)
      : 0;

    const studySessionsCount=db.prepare(
      "SELECT COUNT(*) AS total " +
      "FROM study_sessions " +
      "WHERE user_id=? AND ended_at IS NOT NULL"
    ).get(userId);

    const previousStudyTime=db.prepare(
      "SELECT COALESCE(SUM(seconds),0) AS seconds " +
      "FROM study_sessions " +
      "WHERE user_id=? " +
      "AND ended_at IS NOT NULL " +
      "AND date(started_at,'localtime') >= date('now','localtime','-13 days') " +
      "AND date(started_at,'localtime') < date('now','localtime','-6 days')"
    ).get(userId);

    const currentWeeklyStudySeconds=studyTimeWeekly.reduce(
      (sum,row)=>sum+Number(row.seconds||0),
      0
    );

    const previousWeeklyStudySeconds=Number(
      previousStudyTime?.seconds||0
    );

    let weeklyStudyChangePercent=0;

    if(previousWeeklyStudySeconds>0){
      weeklyStudyChangePercent=Math.round(
        ((currentWeeklyStudySeconds-previousWeeklyStudySeconds) /
        previousWeeklyStudySeconds) * 100
      );
    }else if(currentWeeklyStudySeconds>0){
      weeklyStudyChangePercent=100;
    }

    const topLesson=db.prepare(
      "SELECT " +
      "l.id, l.title, " +
      "COALESCE(SUM(ss.seconds),0) AS seconds " +
      "FROM study_sessions ss " +
      "JOIN lessons l ON l.id=ss.lesson_id " +
      "WHERE ss.user_id=? " +
      "AND ss.ended_at IS NOT NULL " +
      "GROUP BY l.id,l.title " +
      "ORDER BY seconds DESC " +
      "LIMIT 1"
    ).get(userId);

    const topCourse=db.prepare(
      "SELECT " +
      "c.id, c.name, " +
      "COALESCE(SUM(ss.seconds),0) AS seconds " +
      "FROM study_sessions ss " +
      "JOIN lessons l ON l.id=ss.lesson_id " +
      "JOIN subjects s ON s.id=l.subject_id " +
      "JOIN courses c ON c.id=s.course_id " +
      "WHERE ss.user_id=? " +
      "AND ss.ended_at IS NOT NULL " +
      "GROUP BY c.id,c.name " +
      "ORDER BY seconds DESC " +
      "LIMIT 1"
    ).get(userId);
    const activityRows=db.prepare(
      "SELECT DISTINCT date(created_at,'localtime') AS day " +
      "FROM study_events " +
      "WHERE user_id=? " +
      "ORDER BY day DESC"
    ).all(userId);

    const activityDays=activityRows
      .map(x=>String(x.day))
      .filter(Boolean);

    const today=new Date();
    today.setHours(0,0,0,0);

    const toKey=date=>{
      const y=date.getFullYear();
      const m=String(date.getMonth()+1).padStart(2,"0");
      const d=String(date.getDate()).padStart(2,"0");
      return `${y}-${m}-${d}`;
    };

    const activitySet=new Set(activityDays);

    let currentStreak=0;
    const cursor=new Date(today);

    while(activitySet.has(toKey(cursor))){
      currentStreak++;
      cursor.setDate(cursor.getDate()-1);
    }

    let bestStreak=0;
    let runningStreak=0;
    let previousDate=null;

    const sortedActivity=[...activityDays].sort();

    for(const day of sortedActivity){
      const currentDate=new Date(day+"T00:00:00");

      if(previousDate){
        const diff=Math.round(
          (currentDate-previousDate)/(24*60*60*1000)
        );

        if(diff===1){
          runningStreak++;
        }else{
          runningStreak=1;
        }
      }else{
        runningStreak=1;
      }

      bestStreak=Math.max(bestStreak,runningStreak);
      previousDate=currentDate;
    }

    const todayEvents=db.prepare(
      "SELECT COUNT(*) AS total " +
      "FROM study_events " +
      "WHERE user_id=? " +
      "AND date(created_at,'localtime')=date('now','localtime')"
    ).get(userId);
    const courses=db.prepare(
      "SELECT c.id, c.name, " +
      "COUNT(DISTINCT l.id) AS lessons_total, " +
      "COUNT(DISTINCT CASE WHEN l.completed=1 THEN l.id END) AS lessons_completed, " +
      "COUNT(DISTINCT CASE WHEN EXISTS(" +
      "SELECT 1 FROM study_events se WHERE se.user_id=? AND se.lesson_id=l.id" +
      ") THEN l.id END) AS lessons_active " +
      "FROM courses c " +
      "LEFT JOIN subjects s ON s.course_id=c.id " +
      "LEFT JOIN lessons l ON l.subject_id=s.id " +
      "WHERE c.user_id=? " +
      "GROUP BY c.id " +
      "ORDER BY c.id"
    ).all(userId,userId);

    const lessonsDetail=db.prepare(
      "SELECT l.id, l.title, s.name AS subject_name, c.name AS course_name, " +
      "COUNT(DISTINCT f.id) AS flashcards, " +
      "COUNT(DISTINCT r.id) AS reviewed, " +
      "COUNT(DISTINCT CASE WHEN r.last_result='remembered' THEN r.id END) AS remembered " +
      "FROM lessons l " +
      "JOIN subjects s ON s.id=l.subject_id " +
      "JOIN courses c ON c.id=s.course_id " +
      "LEFT JOIN flashcards f ON f.lesson_id=l.id " +
      "LEFT JOIN review_progress r ON r.lesson_id=l.id " +
      "AND r.user_id=? AND r.item_type='flashcard' " +
      "WHERE c.user_id=? " +
      "GROUP BY l.id " +
      "ORDER BY c.id,s.id,l.id"
    ).all(userId,userId);

    const totalReviews=Number(review?.total||0);
    const remembered=Number(review?.remembered||0);

    res.json({
      ok:true,
      summary:{
        flashcardsReviewed:totalReviews,
        remembered,
        forgot:Number(review?.forgot||0),
        memoryRate:totalReviews
          ? Math.round((remembered/totalReviews)*100)
          : 0,
        dueToday:Number(review?.due_today||0),
        lessonsTotal:Number(lessons?.total||0),
        lessonsActive:Number(lessons?.active||0),
        currentStreak,
        bestStreak,
        activeDays:activityDays.length,
        todayEvents:Number(todayEvents?.total||0),
        studyTimeSeconds:totalStudySeconds,
        todayStudySeconds:todayStudySeconds,
        averageStudySeconds,
        studyDays,
        studySessions:Number(studySessionsCount?.total||0),
        weeklyStudySeconds:currentWeeklyStudySeconds,
        previousWeeklyStudySeconds,
        weeklyStudyChangePercent,
        topLesson:topLesson ? {
          id:topLesson.id,
          title:topLesson.title,
          seconds:Number(topLesson.seconds||0)
        } : null,
        topCourse:topCourse ? {
          id:topCourse.id,
          name:topCourse.name,
          seconds:Number(topCourse.seconds||0)
        } : null
      },
      weekly,
      studyTimeWeekly,
      courses,
      lessons:lessonsDetail
    });

  }catch(err){
    console.error("PROGRESS ERROR:",err);
    res.status(500).json({
      error:"Errore nel caricamento dei progressi."
    });
  }
});
