const AI_QUOTAS = {
  FREE: {
    TUTOR: 10,
    SUMMARY: 3,
    CONCEPTS: 3,
    QUIZ: 3,
    FLASHCARDS: 3,
    TRANSCRIPT: 15
  },
  PREMIUM: {
    TUTOR: 100,
    SUMMARY: 30,
    CONCEPTS: 30,
    QUIZ: 30,
    FLASHCARDS: 30,
    TRANSCRIPT: 120
  }
};

function getUserPlan(userId) {
  const row = db.prepare(`
    SELECT plan, status, expires_at
    FROM subscriptions
    WHERE user_id = ?
    ORDER BY id DESC
    LIMIT 1
  `).get(userId);

  if (!row) return "FREE";
  if (row.status !== "ACTIVE") return "FREE";

  if(row.plan !== "PREMIUM"){
    return "FREE";
  }

  if(row.expires_at){
    const expiresAt=Date.parse(String(row.expires_at));

    if(Number.isFinite(expiresAt) && expiresAt <= Date.now()){
      return "FREE";
    }
  }

  return "PREMIUM";
}
function getCurrentMonthUsage(userId, feature) {
  const row = db.prepare(`
    SELECT COALESCE(SUM(units), 0) AS units
    FROM ai_usage
    WHERE user_id = ?
      AND feature = ?
      AND created_at >= date('now', 'start of month')
  `).get(userId, feature);

  return Number(row?.units || 0);
}

function checkAIQuota(userId, feature, units = 1) {
  const plan = getUserPlan(userId);
  const limits = AI_QUOTAS[plan];

  if (!limits || limits[feature] === undefined) {
    return {
      allowed: false,
      reason: "Funzione AI non configurata."
    };
  }

  const requestedUnits = Number(units);

  if (!Number.isFinite(requestedUnits) || requestedUnits <= 0) {
    return {
      allowed: false,
      reason: "Unitï¿½ AI non valide."
    };
  }

  const used = getCurrentMonthUsage(userId, feature);
  const limit = limits[feature];

  if (used + requestedUnits > limit) {
    return {
      allowed: false,
      plan,
      feature,
      used,
      limit,
      remaining: Math.max(0, limit - used),
      reason: "Quota AI mensile esaurita."
    };
  }

  return {
    allowed: true,
    plan,
    feature,
    used,
    limit,
    remaining: limit - used,
    requested: requestedUnits
  };
}

function recordAIUsage(userId, feature, units = 1) {
  const quota = checkAIQuota(userId, feature, units);

  if (!quota.allowed) {
    const error = new Error(quota.reason || "Quota AI non disponibile.");
    error.code = "AI_QUOTA_EXCEEDED";
    error.quota = quota;
    throw error;
  }

  db.prepare(`
    INSERT INTO ai_usage (user_id, feature, units)
    VALUES (?, ?, ?)
  `).run(userId, feature, quota.requested);

  return quota;
}

function generateLocalTutorAnswer(tutorLesson, q, notes = []) {
  const sourceParts = [
    tutorLesson.title ? `Titolo: ${tutorLesson.title}` : "",
    tutorLesson.summary ? `Riassunto: ${tutorLesson.summary}` : "",
    tutorLesson.transcript ? `Trascrizione: ${tutorLesson.transcript}` : "",
    tutorLesson.concepts ? `Concetti: ${tutorLesson.concepts}` : "",
    notes.map(n => n.content || "").filter(Boolean).length
      ? `Appunti: ${notes.map(n => n.content || "").filter(Boolean).join("\n")}`
      : ""
  ].filter(Boolean);

  if(!sourceParts.length){
    return {
      error: "Non c'ï¿½ ancora materiale sufficiente in questa lezione."
    };
  }

  const lower = String(q || "").toLowerCase();
  const title = String(tutorLesson.title || "");
  const summary = String(tutorLesson.summary || "");
  const concepts = String(tutorLesson.concepts || "");
  const conceptList = concepts.split(",").map(x=>x.trim()).filter(Boolean);
  const allText = sourceParts.join("\n");

  const sentences = allText
    .replace(/\s+/g," ")
    .split(/(?<=[.!?])\s+/)
    .map(s=>s.trim())
    .filter(Boolean);

  const stop = [
    "qual","quale","quali","cosa","come","perchï¿½","perche",
    "della","delle","degli","questa","questo","lezione","puoi",
    "spiegare","dimmi","fammi","sono","nella","nelle"
  ];

  const terms = (lower.match(/[a-zï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½]{3,}/g)||[])
    .filter(t=>!stop.includes(t));

  const scoreSentence = (s)=>{
    const sl = s.toLowerCase();
    let score = 0;

    for(const t of terms){
      if(sl.includes(t)) score++;
    }

    if(lower.includes("definiz") && /ï¿½|sono|significa|indica|si definisce/i.test(s)){
      score += 2;
    }

    if(lower.includes("formula") && /formula|=|equazione/i.test(s)){
      score += 3;
    }

    return score;
  };

  const ranked = sentences
    .map(s=>({s,score:scoreSentence(s)}))
    .filter(x=>x.score>0)
    .sort((a,b)=>b.score-a.score);

  let answer = "";

  if(/^(ciao|salve|hey|buongiorno|buonasera)\b/i.test(lower)){
    answer = `Ciao! Sono il tutor di ${title || "questa lezione"}. Posso spiegarti i concetti, chiarire definizioni, riassumere il materiale o aiutarti con domande di ripasso.`;
  }else if(/(riassum|in breve|brevemente|sintesi)/i.test(lower)){
    if(summary){
      answer = `In breve: ${summary}`;
    }else if(ranked.length){
      answer = `In base al materiale: ${ranked.slice(0,4).map(x=>x.s).join(" ")}`;
    }
  }else if(/(concett|punti principal|idee principal|cosa devo ricordare)/i.test(lower)){
    if(conceptList.length){
      answer = `I concetti principali disponibili sono: ${conceptList.join(", ")}. Se vuoi, chiedimi di spiegare uno di questi.`;
    }else if(ranked.length){
      answer = `I punti piï¿½ rilevanti che trovo nel materiale sono: ${ranked.slice(0,4).map(x=>x.s).join(" ")}`;
    }
  }else if(/(definiz|significa|che cos|cos'ï¿½|cosa significa)/i.test(lower) && ranked.length){
    answer = `Dal materiale della lezione: ${ranked.slice(0,3).map(x=>x.s).join(" ")}`;
  }else if(/(formula|equazion|calcol|simbol)/i.test(lower) && ranked.length){
    answer = `Nel materiale trovo questi riferimenti: ${ranked.slice(0,4).map(x=>x.s).join(" ")}`;
  }else if(ranked.length){
    const unique = [];

    for(const item of ranked){
      if(!unique.includes(item.s)) unique.push(item.s);
      if(unique.length >= 4) break;
    }

    answer = `In base al materiale della lezione: ${unique.join(" ")}`;
  }else if(conceptList.length){
    answer = `Non trovo una corrispondenza precisa nella trascrizione o nel riassunto. I concetti disponibili sono: ${conceptList.join(", ")}. Prova a chiedermi, ad esempio, "spiegami ${conceptList[0]}".`;
  }else{
    answer = "Non trovo una risposta precisa nel materiale disponibile. Prova a formulare la domanda con una parola o un concetto presente nella lezione.";
  }

  if(!answer){
    answer = "Non trovo una risposta precisa nel materiale disponibile. Prova a formulare la domanda con una parola o un concetto presente nella lezione.";
  }

  return {
    answer
  };
}
async function generateOpenAIText({instructions,input}){
  if(!process.env.OPENAI_API_KEY){
    const error=new Error("OpenAI non configurato: manca OPENAI_API_KEY.");
    error.code="OPENAI_NOT_CONFIGURED";
    throw error;
  }

  const response=await fetch("https://api.openai.com/v1/responses",{
    method:"POST",
    headers:{
      "Content-Type":"application/json",
      "Authorization":`Bearer ${process.env.OPENAI_API_KEY}`
    },
    body:JSON.stringify({
      model:process.env.OPENAI_TEXT_MODEL || "gpt-6-luna",
      instructions,
      input
    })
  });

  let data={};

  try{
    data=await response.json();
  }catch{}

  if(!response.ok){
    console.error("OPENAI TEXT ERROR:",data);

    const error=new Error(
      data?.error?.message ||
      "Errore nella richiesta OpenAI."
    );

    error.code="OPENAI_TEXT_ERROR";
    error.status=response.status;
    throw error;
  }

  const output=String(data?.output_text || data?.output?.flatMap(x=>x?.content||[]).find(x=>x?.type==="output_text")?.text || "").trim();

  if(!output){
    const error=new Error("OpenAI non ha restituito testo.");
    error.code="OPENAI_EMPTY_RESPONSE";
    throw error;
  }

  return output;
}
function auth(req,res,next){
  try{
    const h=req.headers.authorization||"";
    const token=h.startsWith("Bearer ") ? h.slice(7) : "";
    if(!token) return res.status(401).json({error:"Token mancante."});
    req.user=jwt.verify(token,SECRET);
    next();
  }catch(e){ return res.status(401).json({error:"Sessione non valida."}); }
}
function requireRole(...roles){ return (req,res,next)=>{ if(!roles.includes(req.user.role)) return res.status(403).json({error:"Accesso negato."}); next(); }; }

