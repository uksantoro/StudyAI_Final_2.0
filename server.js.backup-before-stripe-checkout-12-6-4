app.post("/api/ai/flashcards",auth,async(req,res)=>{
  try{
    const { lessonId } = req.body || {};
    const id=Number(lessonId);

    if(!id){
      return res.status(400).json({error:"lessonId obbligatorio."});
    }

    const lesson=db.prepare(`
      SELECT
        l.id,
        l.title,
        l.transcript,
        l.summary,
        l.concepts,
        s.name AS subject_name,
        c.name AS course_name
      FROM lessons l
      JOIN subjects s ON s.id=l.subject_id
      JOIN courses c ON c.id=s.course_id
      WHERE l.id=? AND c.user_id=?
    `).get(id,req.user.id);

    if(!lesson){
      return res.status(404).json({error:"Lezione non trovata."});
    }

    const quota=checkAIQuota(req.user.id,"FLASHCARDS",1);

    if(!quota.allowed){
      return res.status(429).json({
        error:"Quota flashcard AI esaurita.",
        usage:quota
      });
    }

    const sourceText=[
      lesson.title ? `Titolo: ${lesson.title}` : "",
      lesson.summary ? `Riassunto:\n${lesson.summary}` : "",
      lesson.concepts ? `Concetti:\n${lesson.concepts}` : "",
      lesson.transcript ? `Trascrizione:\n${lesson.transcript}` : ""
    ].filter(Boolean).join("\n\n");

    if(!sourceText.trim()){
      return res.status(400).json({
        error:"La lezione non contiene abbastanza materiale per generare flashcard."
      });
    }

    const instructions=`
Sei un esperto di didattica e progettazione di flashcard.

Genera flashcard in italiano basate ESCLUSIVAMENTE sul materiale della lezione fornito.

Obiettivo:
creare domande utili per verificare se lo studente ha realmente capito la lezione, non semplici domande di vocabolario.

Regole obbligatorie:
- genera esattamente 8 flashcard;
- ogni domanda deve verificare un'informazione significativa della lezione;
- evita domande banali come "Cosa significa X?", "Cosa indica X?", "Dove si trova X?" se la risposta è semplicemente una parola o una frase copiata;
- evita di usare come domanda una singola parola o un termine isolato;
- privilegia comprensione, relazioni, causa-effetto, confronto, conseguenze, applicazione e ragionamento;
- almeno 2 domande devono verificare relazioni causa-effetto o conseguenze;
- almeno 2 devono confrontare o distinguere concetti;
- almeno 2 devono richiedere applicazione o ragionamento sul contenuto;
- le restanti possono verificare comprensione di concetti fondamentali;
- non duplicare lo stesso concetto;
- non inventare informazioni non presenti nella lezione;
- le risposte devono essere precise ma sufficientemente complete;
- domanda e risposta devono essere in italiano.

Restituisci SOLO JSON valido nel formato:

{
  "flashcards": [
    {
      "question": "...",
      "answer": "..."
    }
  ]
}
`;

    const raw=await generateOpenAIText({
      instructions,
      input:sourceText.slice(0,30000)
    });

    let parsed;

    try{
      parsed=JSON.parse(raw);
    }catch{
      const match=raw.match(/\{[\s\S]*\}/);

      if(!match){
        throw new Error("Risposta AI non valida.");
      }

      parsed=JSON.parse(match[0]);
    }

    const cards=Array.isArray(parsed?.flashcards)
      ? parsed.flashcards
      : [];

    const validCards=cards
      .map(x=>({
        question:String(x?.question||"").trim(),
        answer:String(x?.answer||"").trim()
      }))
      .filter(x=>{
        if(!x.question || !x.answer) return false;
        if(x.question.length<20) return false;
        if(x.answer.length<5) return false;

        const q=x.question.toLowerCase();

        if(/^cosa significa\b/.test(q)) return false;
        if(/^che cosa significa\b/.test(q)) return false;
        if(/^cosa indica\b/.test(q)) return false;
        if(/^che cosa indica\b/.test(q)) return false;
        if(/^dove si trova\b/.test(q)) return false;
        if(/^dove si trovano\b/.test(q)) return false;

        return true;
      })
      .slice(0,8);

    if(validCards.length<5){
      return res.status(502).json({
        error:"L'AI non ha prodotto abbastanza flashcard di qualità. Riprova."
      });
    }

    const insert=db.prepare(`
      INSERT INTO flashcards(lesson_id,question,answer)
      VALUES(?,?,?)
    `);

    const transaction=db.transaction(cardsToInsert=>{
      for(const card of cardsToInsert){
        insert.run(
          lesson.id,
          card.question,
          card.answer
        );
      }
    });

    transaction(validCards);

    const usage=recordAIUsage(req.user.id,"FLASHCARDS");

    res.json({
      ok:true,
      count:validCards.length,
      usage
    });

  }catch(err){
