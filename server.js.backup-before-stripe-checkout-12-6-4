app.post("/api/subscription/upgrade",auth,(req,res)=>{
  try{
    const userId=req.user.id;

    const current=db.prepare(`
      SELECT *
      FROM subscriptions
      WHERE user_id=?
      ORDER BY id DESC
      LIMIT 1
    `).get(userId);

    if(current){
      const currentPlan=String(current.plan||"FREE").toUpperCase();
      const currentStatus=String(current.status||"").toUpperCase();

      if(currentPlan==="PREMIUM" && currentStatus==="ACTIVE"){
        if(!current.expires_at || Date.parse(String(current.expires_at))>Date.now()){
          return res.status(409).json({
            error:"L'utente è già PREMIUM."
          });
        }
      }
    }

    const startedAt=new Date();
    const expiresAt=new Date(startedAt.getTime()+30*24*60*60*1000);

    const result=db.prepare(`
      INSERT INTO subscriptions(
        user_id,
        plan,
        status,
        started_at,
        expires_at,
        amount,
        auto_renew
      )
      VALUES(?,?,?,?,?,?,?)
    `).run(
      userId,
      "PREMIUM",
      "ACTIVE",
      startedAt.toISOString(),
      expiresAt.toISOString(),
      9.99,
      1
    );

    const subscription=db.prepare(`
      SELECT *
      FROM subscriptions
      WHERE id=?
    `).get(result.lastInsertRowid);

    audit(
      req,
      "SUBSCRIPTION_UPGRADED",
      `Upgrade PREMIUM per utente ${userId}: subscription=${result.lastInsertRowid}, importo=9.99, auto_renew=1`
    );

    res.json({
      ok:true,
      subscription
    });
  }catch(err){
    console.error("SUBSCRIPTION UPGRADE ERROR:",err);
    res.status(500).json({
      error:"Errore durante l'upgrade Premium."
    });
  }
});
app.post("/api/subscription/renew",auth,(req,res)=>{
  try{
    const userId=req.user.id;

    const current=db.prepare(`
      SELECT *
      FROM subscriptions
      WHERE user_id=?
      ORDER BY id DESC
      LIMIT 1
    `).get(userId);

    if(!current){
      return res.status(404).json({
        error:"Nessun abbonamento da rinnovare."
      });
    }

    const currentPlan=String(current.plan||"FREE").toUpperCase();

    if(currentPlan!=="PREMIUM"){
      return res.status(409).json({
        error:"L'utente non ha un abbonamento PREMIUM da rinnovare."
      });
    }

    const now=new Date();

    let baseDate=now;

    if(current.expires_at){
      const currentExpiry=Date.parse(String(current.expires_at));

      if(Number.isFinite(currentExpiry) && currentExpiry>now.getTime()){
        baseDate=new Date(currentExpiry);
      }
    }

    const newExpiresAt=new Date(
      baseDate.getTime()+30*24*60*60*1000
    );

    db.prepare(`
      UPDATE subscriptions
      SET
        status=?,
        expires_at=?,
        amount=?,
        auto_renew=?
      WHERE id=?
    `).run(
      "ACTIVE",
      newExpiresAt.toISOString(),
      9.99,
      1,
      current.id
    );

    audit(
      req,
      "SUBSCRIPTION_RENEWED",
      `Rinnovo PREMIUM per utente ${userId}: subscription=${current.id}, nuova_scadenza=${newExpiresAt.toISOString()}, importo=9.99, auto_renew=1`
    );

    const subscription=db.prepare(`
      SELECT *
      FROM subscriptions
      WHERE id=?
    `).get(current.id);

    res.json({
      ok:true,
      subscription
    });
  }catch(err){
    console.error("SUBSCRIPTION RENEW ERROR:",err);
    res.status(500).json({
      error:"Errore durante il rinnovo Premium."
    });
  }
});
