app.post("/api/study-session/heartbeat",auth,(req,res)=>{
  try{
    const sessionId=Number(req.body?.sessionId);

    if(!sessionId){
      return res.status(400).json({
        error:"sessionId obbligatorio."
      });
    }

    const session=db.prepare(`
      SELECT *
      FROM study_sessions
      WHERE id=?
        AND user_id=?
        AND ended_at IS NULL
    `).get(
      sessionId,
      req.user.id
    );

    if(!session){
      return res.status(404).json({
        error:"Sessione di studio non trovata."
      });
    }

    const result=db.prepare(`
      UPDATE study_sessions
      SET
        seconds=seconds + MIN(
          120,
          MAX(
            0,
            CAST(
              strftime('%s','now') -
              strftime('%s',last_seen_at)
              AS INTEGER
            )
          )
        ),
        last_seen_at=CURRENT_TIMESTAMP
      WHERE id=?
        AND user_id=?
        AND ended_at IS NULL
    `).run(
      sessionId,
      req.user.id
    );

    const updated=db.prepare(`
      SELECT seconds
      FROM study_sessions
      WHERE id=? AND user_id=?
    `).get(
      sessionId,
      req.user.id
    );

    res.json({
      ok:true,
      sessionId,
      seconds:Number(updated?.seconds||0),
      updated:result.changes>0
