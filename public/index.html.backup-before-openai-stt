<body>
<div id="root"></div>
<script>
const API="/api"; let token=localStorage.getItem("studyai_final_token"); let state={view:"dashboard",data:null,lesson:null,tab:"audio",flashIndex:0,quizIndex:0,quizScore:0,quizAnswers:{},quizCompleted:false};
const $=s=>document.querySelector(s);
async function api(path,opts={}){const h=opts.headers||{}; if(!(opts.body instanceof FormData))h["Content-Type"]="application/json"; if(token)h.Authorization="Bearer "+token; const r=await fetch(API+path,{...opts,headers:h}); let d={}; try{d=await r.json()}catch{} if(!r.ok)throw new Error(d.error||"Errore"); return d}
function esc(s=""){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function toast(t){const x=document.createElement("div");x.className="toast";x.textContent=t;document.body.appendChild(x);setTimeout(()=>x.remove(),2600)}
function modal(title,body){const x=document.createElement("div");x.className="modal-back";x.innerHTML=`<div class="modal"><div class="modal-head"><h2>${title}</h2><button class="btn ghost small" data-close>✕</button></div>${body}</div>`;document.body.appendChild(x);x.onclick=e=>{if(e.target===x||e.target.closest("[data-close]"))x.remove()};return x}
function nav(){return `<aside class="sidebar"><div class="brand">Study<span>AI</span> 🎓</div><div class="nav">${navBtn("dashboard","⌂","Home")}${navBtn("courses","▣","Corsi")}${navBtn("lessons","▤","Lezioni")}${navBtn("notes","▱","Appunti")}${navBtn("quiz","◈","Quiz")}${navBtn("maps","⌘","Mappe")}${navBtn("stats","▥","Statistiche")}${state.me?.role==="ADMIN"||state.me?.role==="SUPER_ADMIN"?navBtn("admin","🛡","Admin"):""}</div><div class="nav nav-bottom">${navBtn("settings","⚙","Impostazioni")}<button id="logout">↪ Esci</button></div></aside><nav class="mobile-nav">${navBtn("dashboard","⌂","Home")}${navBtn("courses","▣","Corsi")}${navBtn("lessons","▤","Lezioni")}${navBtn("quiz","◈","Quiz")}${navBtn("stats","⋯","Altro")}${state.me?.role==="ADMIN"||state.me?.role==="SUPER_ADMIN"?navBtn("admin","🛡","Admin"):""}</nav>`}
function navBtn(v,i,t){return `<button class="${state.view===v?"active":""}" data-nav="${v}">${i} <span>${t}</span></button>`}
function layout(content){return `<div class="app">${nav()}<main class="main"><div class="topbar"><div class="search"><input id="search" placeholder="Cerca lezioni, appunti, corsi..." autocomplete="off"><div id="results" class="result-list hidden"></div></div><div class="user"><div class="avatar">${esc((state.me?.name||"S").slice(0,1).toUpperCase())}</div><b>${esc(state.me?.name||"Studente")}</b></div></div>${content}</main></div>`}
