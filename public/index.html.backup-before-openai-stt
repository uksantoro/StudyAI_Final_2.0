.course-card:nth-child(4n+3){background:linear-gradient(135deg,#1fc37b,#0b9b62)}
.course-card:nth-child(4n){background:linear-gradient(135deg,#ff9b25,#f04430)}
.course-card .course-kicker{font-size:12px;opacity:.82;text-transform:uppercase;letter-spacing:.08em;font-weight:800;margin-bottom:7px}
