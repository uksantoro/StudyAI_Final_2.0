@media(max-width:800px){.maps-grid{grid-template-columns:1fr}}
.chat{min-height:360px;display:flex;flex-direction:column;gap:12px}.bubble{padding:12px 14px;border-radius:15px;max-width:85%;background:#f0edff}.bubble.me{align-self:flex-end;background:#6d4aff;color:#fff}.chat-input{display:flex;gap:8px;margin-top:auto}.chat-input input{flex:1;padding:12px;border:1px solid var(--line);border-radius:12px}.toast{position:fixed;right:20px;bottom:20px;background:#12162b;color:#fff;padding:13px 16px;border-radius:12px;z-index:100;box-shadow:var(--shadow)}.empty{text-align:center;padding:35px;color:var(--muted)}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#0d1328,#35227f 55%,#6d4aff)}.login{width:min(440px,100%);background:#fff;border-radius:25px;padding:30px;box-shadow:0 30px 90px rgba(0,0,0,.3)}.login .brand{color:var(--ink);padding:0 0 15px}.result-list{position:absolute;top:52px;left:0;right:0;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);z-index:30;max-height:350px;overflow:auto}.result{padding:11px 14px;border-bottom:1px solid var(--line)}.result:hover{background:#f6f4ff}.mobile-nav{display:none}
