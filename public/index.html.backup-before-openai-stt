<title>StudyAI</title>
<style>
:root{--bg:#f5f6fb;--panel:#fff;--ink:#10152b;--muted:#68708a;--line:#e6e8f0;--purple:#6d4aff;--blue:#2e8bff;--navy:#0d1328;--grad:linear-gradient(135deg,#35227f,#6847ff);--shadow:0 16px 45px rgba(29,22,79,.10)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink)}button,input,textarea,select{font:inherit}button{cursor:pointer;border:0}.hidden{display:none!important}.app{min-height:100vh}.sidebar{position:fixed;left:0;top:0;bottom:0;width:250px;background:var(--navy);color:#fff;padding:22px 16px;z-index:20}.brand{font-size:25px;font-weight:900;padding:8px 12px 28px}.brand span{color:#7d62ff}.nav{display:grid;gap:6px}.nav button{background:transparent;color:#dbe0f4;text-align:left;padding:12px 14px;border-radius:12px}.nav button:hover,.nav button.active{background:#6847ff;color:#fff}.nav-bottom{position:absolute;bottom:20px;left:16px;right:16px}.main{margin-left:250px;min-height:100vh;padding:24px 28px 90px}.topbar{display:flex;align-items:center;gap:14px;margin-bottom:24px}.search{flex:1;max-width:600px;position:relative}.search input{width:100%;padding:14px 18px;border:1px solid var(--line);border-radius:15px;background:#fff;outline:none}.user{margin-left:auto;display:flex;align-items:center;gap:10px}.avatar{width:40px;height:40px;border-radius:50%;background:var(--purple);color:#fff;display:grid;place-items:center;font-weight:800}.hero{background:var(--grad);color:#fff;border-radius:25px;padding:28px 30px;box-shadow:var(--shadow);margin-bottom:24px}.hero h1{margin:0 0 8px;font-size:30px}.hero p{margin:0;color:#eeeaff}.btn{padding:11px 16px;border-radius:12px;background:var(--purple);color:#fff;font-weight:800}.btn.light{background:#fff;color:var(--purple)}.btn.ghost{background:#f1efff;color:#5136d5}.btn.danger{background:#ffe9ec;color:#b21d3a}.btn.small{padding:8px 11px;font-size:13px}.grid{display:grid;gap:18px} .courses{grid-template-columns:repeat(3,minmax(0,1fr))}
