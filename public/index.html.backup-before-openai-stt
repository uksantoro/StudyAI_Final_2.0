function generateLocalConcepts(l){
  const text=[l.title||"",l.summary||"",l.transcript||""].join(" ").toLowerCase();
  const stop=new Set(("a ad al alla allo ai agli alle con da dal dalla delle dei degli del della di e ed è in nel nella nei negli nelle il lo la i gli le un una uno per tra fra su che chi cui come come si sono era essere stato questa questo queste questi quella quello quelle quelli più meno molto anche non una uno degli delle delle loro loro suo sua suoi sue dove quando perché quindi se ma o od e poi già può possono deve devono hanno ha ho hai fare fatto parte tipo modo cosa cose corso lezione testo appunti concetto concetti").split(/\s+/));
  const words=(text.match(/[a-zàèéìòóù]{3,}/gi)||[]).map(w=>w.toLowerCase()).filter(w=>!stop.has(w));
  const freq={};
  for(const w of words) freq[w]=(freq[w]||0)+1;
  const ranked=Object.entries(freq).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0]));
  const out=[];
  for(const [w] of ranked){
    if(out.length>=4) break;
    if(!out.some(x=>x.toLowerCase()===w)) out.push(w.charAt(0).toUpperCase()+w.slice(1));
  }
  return out.join(", ");
}
