.tutor-ai{background:#f3f0ff;border:1px solid #ddd7ff}
.tutor-form{display:flex;gap:8px;margin-top:auto}
.tutor-form input{flex:1;padding:13px 15px;border:1px solid var(--line);border-radius:12px;outline:none}
@media(max-width:800px){.tutor-box{grid-template-columns:1fr}.tutor-chat{min-height:320px}}
.maps-toolbar{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:10px;margin-bottom:18px}.maps-toolbar input,.maps-toolbar select{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;outline:none}.map-card.hidden{display:none}@media(max-width:800px){.maps-toolbar{grid-template-columns:1fr}}.maps-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.map-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:var(--shadow)}
.map-card-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
