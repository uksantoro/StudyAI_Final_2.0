async function loadStats(){const d=await api("/stats");document.getElementById("root").innerHTML=layout(`<div class="section-head"><h2>Statistiche</h2></div><div class="stats"><div class="panel stat"><strong>${d.courses}</strong><span>Corsi</span></div><div class="panel stat"><strong>${d.subjects}</strong><span>Materie</span></div><div class="panel stat"><strong>${d.lessons}</strong><span>Lezioni</span></div><div class="panel stat"><strong>${d.percent}%</strong><span>Completamento</span></div></div><div class="grid two section"><div class="panel"><h2>Progresso</h2><div class="progress" style="margin:20px 0"><i style="width:${d.percent}%"></i></div><p>${d.completed} lezioni completate su ${d.lessons}</p></div><div class="panel"><h2>Audio</h2><p style="font-size:28px;font-weight:900">${d.audio}</p><p class="muted">registrazioni caricate</p></div></div>`);bindCommon()}
async function noteModal(note, lessons){
  const options=lessons.map(l=>`<option value="${l.id}" ${note&&String(note.lesson_id)===String(l.id)?"selected":""}>${esc(l.title)} · ${esc(l.subject_name||"")}</option>`).join("");
  const m=modal(note?"Modifica appunto":"Nuovo appunto",`<form class="form" id="noteForm"><select id="lessonId" ${note?"disabled":""} required>${options}</select><textarea id="noteBody" rows="9" placeholder="Scrivi il tuo appunto..." required>${esc(note?.body||"")}</textarea><button class="btn">${note?"Salva modifiche":"Salva appunto"}</button></form>`);
  m.querySelector("#noteForm").onsubmit=async e=>{
    e.preventDefault();
    const body=m.querySelector("#noteBody").value.trim();
    if(!body)return;
    if(note) await api("/notes/"+note.id,{method:"PATCH",body:JSON.stringify({body})});
    else await api("/lessons/"+m.querySelector("#lessonId").value+"/notes",{method:"POST",body:JSON.stringify({body})});
    m.remove(); loadNotes();
  };
}
async function loadNotes(){
  const d=await api("/dashboard");
  const lessonDetails=await Promise.all((d.lessons||[]).map(l=>api("/lessons/"+l.id).catch(()=>null)));
  const lessons=(d.lessons||[]).map((l,i)=>({...l,...((lessonDetails[i]||{}).lesson||{})}));
  const notes=[];
  lessonDetails.forEach((x,i)=>{
    (x?.notes||[]).forEach(n=>notes.push({...n,lesson_title:lessons[i]?.title||"",course_name:lessons[i]?.course_name||"",subject_name:lessons[i]?.subject_name||""}));
  });
  state.notes=notes;
  document.getElementById("root").innerHTML=layout(`<div class="section-head"><div><h2>Appunti</h2><p class="muted">Raccogli e modifica i tuoi appunti collegandoli alle lezioni.</p></div><button class="btn" id="newNote">＋ Nuovo appunto</button></div><div class="notes-toolbar"><input class="notes-search" id="noteSearch" placeholder="Cerca negli appunti..." value=""></div><div id="notesList" class="notes-grid"></div>`);
  bindCommon();
  const renderNotes=()=>{
    const q=($("#noteSearch")?.value||"").trim().toLowerCase();
    const filtered=notes.filter(n=>(`${n.body} ${n.lesson_title} ${n.subject_name} ${n.course_name}`).toLowerCase().includes(q));
    $("#notesList").innerHTML=filtered.length?filtered.map(n=>`<article class="note-card"><h3>${esc(n.lesson_title)}</h3><div class="note-meta">${esc(n.course_name)} · ${esc(n.subject_name)}${n.updated_at?` · ${esc(n.updated_at)}`:""}</div><div class="note-body">${esc(n.body)}</div><div class="note-actions"><button class="btn ghost small" data-edit-note="${n.id}">✎ Modifica</button><button class="btn danger small" data-delete-note="${n.id}">× Elimina</button><button class="btn small" data-open-note-lesson="${n.lesson_id}">Apri lezione</button></div></article>`).join(""):`<div class="panel empty" style="grid-column:1/-1">${q?"Nessun appunto trovato.":"Nessun appunto ancora. Crea il primo per iniziare."}</div>`;
    document.querySelectorAll("[data-edit-note]").forEach(b=>b.onclick=()=>{const n=notes.find(x=>String(x.id)===String(b.dataset.editNote));noteModal(n,lessons)});
    document.querySelectorAll("[data-delete-note]").forEach(b=>b.onclick=async()=>{if(confirm("Eliminare questo appunto?")){await api("/notes/"+b.dataset.deleteNote,{method:"DELETE"});loadNotes()}});
    document.querySelectorAll("[data-open-note-lesson]").forEach(b=>b.onclick=()=>{state.lessonId=b.dataset.openNoteLesson;state.view="lesson";state.tab="transcript";render()});
  };
  $("#newNote").onclick=()=>noteModal(null,lessons);
  $("#noteSearch").oninput=renderNotes;
  renderNotes();
}
async function loadCategory(){
  if(state.view==="notes")return loadNotes();
  const d=await api("/dashboard");
  if(state.view==="maps"){
    const details=await Promise.all((d.lessons||[]).map(l=>api("/lessons/"+l.id).catch(()=>null)));
    const maps=(d.lessons||[]).map((l,i)=>({...l,...((details[i]||{}).lesson||{})})).filter(l=>String(l.concepts||"").trim());
    const courses=[...new Set(maps.map(l=>String(l.course_name||"").trim()).filter(Boolean))].sort();
    const subjects=[...new Set(maps.map(l=>String(l.subject_name||"").trim()).filter(Boolean))].sort();
    const cards=maps.map(l=>{
      const concepts=String(l.concepts||"").split(",").map(x=>x.trim()).filter(Boolean).slice(0,4);
      return `<article class="map-card" data-map-card data-course="${esc(l.course_name||"")}" data-subject="${esc(l.subject_name||"")}" data-search="${esc((l.title+" "+(l.course_name||"")+" "+(l.subject_name||"")+" "+concepts.join(" ")).toLowerCase())}">
        <div class="map-card-head"><div><h3>${esc(l.title)}</h3><div class="muted">${esc(l.course_name||"")} · ${esc(l.subject_name||"")}</div></div><span class="badge">${concepts.length} concetti</span></div>
        <div class="map-mini"><div class="map-mini-center">${esc(l.title)}</div>${concepts.map(c=>`<span>${esc(c)}</span>`).join("")}</div>
        <div class="map-card-actions"><button class="btn small" data-open-map="${l.id}">Apri mappa</button><button class="btn ghost small" data-edit-map="${l.id}">Modifica concetti</button></div>
      </article>`;
    }).join("");
    const courseOptions=courses.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("");
    const subjectOptions=subjects.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("");
    document.getElementById("root").innerHTML=layout(`<div class="section-head"><div><h2>Mappe concettuali</h2><p class="muted">Tutte le mappe create dalle tue lezioni, in un unico spazio.</p></div></div>
      <div class="maps-toolbar"><input id="mapSearch" placeholder="Cerca lezione o concetto..."><select id="mapCourse"><option value="">Tutti i corsi</option>${courseOptions}</select><select id="mapSubject"><option value="">Tutte le materie</option>${subjectOptions}</select></div>
      <div class="maps-grid">${cards||`<div class="panel empty" style="grid-column:1/-1"><h3>Nessuna mappa ancora</h3><p>Crea o genera i concetti dentro una lezione per vedere qui la relativa mappa.</p></div>`}</div>`);
    bindCommon();
    const filterMaps=()=>{
      const q=($("#mapSearch")?.value||"").toLowerCase().trim(), c=$("#mapCourse")?.value||"", sub=$("#mapSubject")?.value||"";
      document.querySelectorAll("[data-map-card]").forEach(card=>{
        const ok=(!q||card.dataset.search.includes(q))&&(!c||card.dataset.course===c)&&(!sub||card.dataset.subject===sub);
        card.classList.toggle("hidden",!ok);
      });
    };
    $("#mapSearch")?.addEventListener("input",filterMaps); $("#mapCourse")?.addEventListener("change",filterMaps); $("#mapSubject")?.addEventListener("change",filterMaps);
    document.querySelectorAll("[data-open-map]").forEach(b=>b.onclick=()=>{state.lessonId=b.dataset.openMap;state.view="lesson";state.tab="map";render()});
    document.querySelectorAll("[data-edit-map]").forEach(b=>b.onclick=()=>{state.lessonId=b.dataset.editMap;state.view="lesson";state.tab="map";render()});
    return;
  }
  let title=state.view==="lessons"?"Lezioni":"Quiz";
  document.getElementById("root").innerHTML=layout(`<div class="section-head"><h2>${title}</h2></div><div class="panel">${d.lessons.length?d.lessons.map(lessonRow).join(""):`<div class="empty">Nessun contenuto disponibile.</div>`}</div>`);
  bindCommon();bindRows()
}
render();
</script>
