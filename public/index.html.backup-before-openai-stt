function bindRecorder(){
  const start=$("#startRecord"), pause=$("#pauseRecord"), stop=$("#stopRecord"), timer=$("#recordTimer"), status=$("#recordStatus");
  if(!start) return;
  let recorder=null, chunks=[], startedAt=0, timerId=null, stream=null;
  const setTime=()=>{const s=Math.floor((Date.now()-startedAt)/1000);timer.textContent=String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")};
  start.onclick=async()=>{
    try{
      if(!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) throw new Error("La registrazione dal browser non è supportata su questo dispositivo.");
      stream=await navigator.mediaDevices.getUserMedia({audio:true});
      const mime=["audio/webm;codecs=opus","audio/webm","audio/ogg;codecs=opus"].find(x=>MediaRecorder.isTypeSupported(x))||"";
      recorder=mime?new MediaRecorder(stream,{mimeType:mime}):new MediaRecorder(stream);
      chunks=[]; recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};
      recorder.onstop=async()=>{
        clearInterval(timerId); timer.classList.add("hidden"); pause.classList.add("hidden"); stop.classList.add("hidden"); start.classList.remove("hidden");
        stream?.getTracks().forEach(t=>t.stop());
        const blob=new Blob(chunks,{type:recorder.mimeType||"audio/webm"});
        const ext=(blob.type.includes("ogg")?"ogg":"webm");
        const file=new File([blob],"registrazione_"+new Date().toISOString().replace(/[:.]/g,"-")+"."+ext,{type:blob.type||"audio/webm"});
        const fd=new FormData(); fd.append("audio",file);
        status.textContent="Salvataggio registrazione...";
        try{await api("/lessons/"+state.lessonId+"/audio",{method:"POST",body:fd});toast("Registrazione salvata");render()}
        catch(err){status.textContent="Errore nel salvataggio: "+err.message}
      };
      recorder.start(250); startedAt=Date.now(); timer.classList.remove("hidden"); pause.classList.remove("hidden"); stop.classList.remove("hidden"); start.classList.add("hidden"); status.textContent="Registrazione in corso..."; timerId=setInterval(setTime,1000); setTime();
    }catch(err){status.textContent=err.message}
  };
  pause.onclick=()=>{
    if(!recorder) return;
    if(recorder.state==="recording"){recorder.pause();pause.textContent="▶ Riprendi";status.textContent="Registrazione in pausa."}
    else if(recorder.state==="paused"){recorder.resume();pause.textContent="Ⅱ Pausa";status.textContent="Registrazione in corso..."}
  };
