function tutorLocalAnswer(l,q){
  const lesson=l||{};
  const notes=Array.isArray(lesson.notes)?lesson.notes.map(n=>n?.content||n?.text||"").filter(Boolean):[];
  const flashcards=Array.isArray(lesson.flashcards)?lesson.flashcards:[];
  const questions=Array.isArray(lesson.questions)?lesson.questions:[];
  const title=String(lesson.title||"");
  const summary=String(lesson.summary||"");
  const transcript=String(lesson.transcript||"");
  const concepts=String(lesson.concepts||"");
  const notesText=notes.join("\n");
  const sourceParts=[
    title?`Titolo: ${title}`:"",
    summary?`Riassunto: ${summary}`:"",
    transcript?`Trascrizione: ${transcript}`:"",
    concepts?`Concetti: ${concepts}`:"",
    notesText?`Appunti: ${notesText}`:""
  ].filter(Boolean);
  if(!sourceParts.length) return "Non ho ancora materiale sufficiente in questa lezione. Inserisci una trascrizione, un riassunto, dei concetti o degli appunti e riprova.";
  const clean=String(q||"").trim();
  if(!clean) return "Scrivimi una domanda sulla lezione.";

  const lower=clean.toLowerCase();
  const stop=["qual","quale","quali","cosa","come","perché","perche","della","delle","degli","questa","questo","lezione","puoi","spiegare","dimmi","fammi","sono","nella","nelle"];
  const terms=(lower.match(/[a-zàèéìòóù]{3,}/g)||[]).filter(t=>!stop.includes(t));
  const allText=sourceParts.join("\n");
  const sentences=allText.replace(/\s+/g," ").split(/(?<=[.!?])\s+/).map(s=>s.trim()).filter(Boolean);

  const scoreSentence=(s)=>{
    const sl=s.toLowerCase();
    let score=0;
    for(const t of terms) if(sl.includes(t)) score++;
    if(lower.includes("definiz") && /è|sono|significa|indica|si definisce/i.test(s)) score+=2;
    if(lower.includes("formula") && /formula|=|equazione/i.test(s)) score+=3;
    return score;
  };

  const ranked=sentences.map(s=>({s,score:scoreSentence(s)})).filter(x=>x.score>0).sort((a,b)=>b.score-a.score);
  const conceptList=concepts.split(",").map(x=>x.trim()).filter(Boolean);

  if(/^(ciao|salve|hey|buongiorno|buonasera)\b/i.test(lower))
    return `Ciao! Sono il tutor di ${title||"questa lezione"}. Posso spiegarti i concetti, chiarire definizioni, riassumere il materiale o aiutarti con domande di ripasso.`;

  if(/(riassum|in breve|brevemente|sintesi)/i.test(lower)){
    if(summary) return `In breve: ${summary}`;
    if(ranked.length) return `In base al materiale: ${ranked.slice(0,4).map(x=>x.s).join(" ")}`;
  }

  if(/(concett|punti principal|idee principal|cosa devo ricordare)/i.test(lower)){
    if(conceptList.length) return `I concetti principali disponibili sono: ${conceptList.join(", ")}. Se vuoi, chiedimi di spiegare uno di questi.`;
    if(ranked.length) return `I punti più rilevanti che trovo nel materiale sono: ${ranked.slice(0,4).map(x=>x.s).join(" ")}`;
  }

  if(/(flashcard|domande.*quiz|quiz|ripasso)/i.test(lower) && (flashcards.length || questions.length)){
    const parts=[];
    if(flashcards.length) parts.push(`${flashcards.length} flashcard`);
    if(questions.length) parts.push(`${questions.length} domande quiz`);
    return `Per questa lezione hai ${parts.join(" e ")} disponibili. Posso anche spiegarti gli argomenti prima del ripasso.`;
  }

  if(/(definiz|significa|che cos|cos'è|cosa significa)/i.test(lower) && ranked.length)
    return `Dal materiale della lezione: ${ranked.slice(0,3).map(x=>x.s).join(" ")}`;

  if(/(formula|equazion|calcol|simbol)/i.test(lower) && ranked.length)
    return `Nel materiale trovo questi riferimenti: ${ranked.slice(0,4).map(x=>x.s).join(" ")}`;

  if(ranked.length){
    const unique=[];
    for(const item of ranked){ if(!unique.includes(item.s)) unique.push(item.s); if(unique.length>=4) break; }
    return `In base al materiale della lezione: ${unique.join(" ")}`;
  }

  if(conceptList.length)
    return `Non trovo una corrispondenza precisa nella trascrizione o nel riassunto. I concetti disponibili sono: ${conceptList.join(", ")}. Prova a chiedermi, ad esempio, "spiegami ${conceptList[0]}".`;

  return "Non trovo una risposta precisa nel materiale disponibile. Prova a formulare la domanda con una parola o un concetto presente nella lezione.";
}
