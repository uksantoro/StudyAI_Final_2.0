.map-mini:before{transform:rotate(32deg)}.map-mini:after{transform:rotate(-32deg)}
.map-mini-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2;background:var(--purple);color:#fff;padding:9px 12px;border-radius:12px;font-size:11px;font-weight:800;max-width:125px;text-align:center}
.map-mini span{position:absolute;background:#fff;border:1px solid #ddd7ff;border-radius:10px;padding:7px 9px;font-size:11px;font-weight:700;max-width:105px;z-index:2}
