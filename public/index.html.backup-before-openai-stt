.course-card .actions .btn{box-shadow:0 5px 12px rgba(0,0,0,.10)}
@media (max-width:1050px){.courses{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:700px){.courses{grid-template-columns:1fr}.course-card{min-height:220px}}.section{margin:26px 0}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.section h2{margin:0;font-size:22px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:0 8px 25px rgba(20,20,50,.04)}.two{grid-template-columns:1.3fr .7fr}.three{grid-template-columns:repeat(3,1fr)}.lesson-row{display:flex;align-items:center;gap:14px;padding:13px 0;border-bottom:1px solid var(--line)}.lesson-row:last-child{border-bottom:0}.icon{width:40px;height:40px;border-radius:12px;background:#f0edff;color:var(--purple);display:grid;place-items:center;font-weight:900}.grow{flex:1}.muted{color:var(--muted);font-size:13px}.progress{height:10px;background:#eceef5;border-radius:99px;overflow:hidden}.progress i{display:block;height:100%;background:linear-gradient(90deg,#6d4aff,#31c6a2);border-radius:99px}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.stat{padding:13px;border:1px solid var(--line);border-radius:15px;background:#fafaff}.stat strong{font-size:25px;line-height:1.1}.stat span{display:block;color:var(--muted);font-size:12px;margin-top:4px}.study-note{margin-top:14px;padding:10px 12px;border-radius:12px;background:#f7f5ff;color:var(--muted);font-size:12px}.recent-lesson{padding:15px 0}.notes-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.notes-search{max-width:420px;width:100%}.notes-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.note-card{padding:18px;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 6px 18px rgba(39,23,93,.05)}.note-card h3{margin:0 0 6px;font-size:16px}.note-meta{color:var(--muted);font-size:12px;margin-bottom:11px}.note-body{white-space:pre-wrap;line-height:1.55;color:#333;font-size:14px}.note-actions{display:flex;gap:7px;margin-top:14px}@media(max-width:800px){.notes-grid{grid-template-columns:1fr}.notes-toolbar{align-items:stretch;flex-direction:column}.notes-search{max-width:none}}.subject-lessons{display:grid;grid-template-columns:1fr;gap:12px}.subject-lesson{padding:17px;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:0 6px 18px rgba(39,23,93,.05);display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center}.subject-lesson .lesson-icon{width:48px;height:48px;border-radius:15px;background:#f0ecff;display:grid;place-items:center;font-size:21px}.subject-lesson h3{margin:0 0 5px;font-size:16px}.subject-lesson .lesson-meta{color:var(--muted);font-size:12px}.lesson-statuses{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.lesson-status{display:inline-flex;padding:4px 8px;border-radius:999px;background:#f1edff;color:#5b3bd7;font-size:11px;font-weight:700}.lesson-status.off{background:#f4f5f8;color:#777}.lesson-status.done{background:#eaf8f1;color:#168052}.lesson-actions{display:flex;gap:6px;align-items:center}@media(max-width:600px){.subject-lesson{grid-template-columns:auto 1fr}.lesson-actions{grid-column:2;justify-content:flex-start}.subject-lesson .lesson-icon{width:42px;height:42px}}.lesson-overview{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-top:16px}.lesson-overview .overview-item{padding:12px 10px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.10);border-radius:15px;color:#fff}.lesson-overview strong{display:block;font-size:17px}.lesson-overview span{display:block;font-size:11px;opacity:.82;margin-top:3px}@media(max-width:900px){.lesson-overview{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.lesson-overview{grid-template-columns:repeat(2,minmax(0,1fr))}}.study-suggestions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.suggestion{padding:16px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 6px 18px rgba(39,23,93,.05);display:flex;flex-direction:column}.suggestion .suggestion-icon{width:42px;height:42px;border-radius:13px;background:#f0ecff;display:grid;place-items:center;font-size:20px;margin-bottom:11px}.suggestion h3{margin:0 0 6px;font-size:15px}.suggestion p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.suggestion .btn{margin-top:14px;align-self:flex-start}@media(max-width:900px){.study-suggestions{grid-template-columns:1fr}}.lesson-badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.lesson-badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;background:#f0ecff;color:#5b3bd7;font-size:11px;font-weight:700}.muted-badge{background:#f4f5f8;color:#777}.done-badge{background:#eaf8f1;color:#168052}.quick-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.quick-action{display:flex;align-items:center;gap:12px;text-align:left;padding:15px;border:1px solid var(--line);background:#fff;border-radius:18px;cursor:pointer;transition:.18s;box-shadow:0 6px 18px rgba(39,23,93,.05)}.quick-action:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(39,23,93,.09)}.quick-action .qa-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:#f0ecff;font-size:20px;flex:0 0 auto}.quick-action b{display:block;font-size:14px}.quick-action span{display:block;margin-top:3px;color:var(--muted);font-size:12px}@media(max-width:900px){.quick-actions{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.quick-actions{grid-template-columns:1fr}}@media(max-width:700px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}.form{display:grid;gap:12px}.form input,.form textarea,.form select{width:100%;padding:12px 13px;border:1px solid var(--line);border-radius:11px;outline:none;background:#fff}.form textarea{min-height:130px;resize:vertical}.modal-back{position:fixed;inset:0;background:rgba(8,10,25,.58);display:grid;place-items:center;padding:18px;z-index:50}.modal{background:#fff;border-radius:20px;width:min(560px,100%);padding:24px;max-height:90vh;overflow:auto}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.lesson-tabs{display:flex;gap:7px;overflow-x:auto;overflow-y:hidden;padding:2px 2px 5px;scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;touch-action:pan-x}.lesson-tabs::-webkit-scrollbar{display:none}.lesson-tabs .tab{flex:0 0 auto}.tab{white-space:nowrap;padding:10px 13px;border-radius:11px;background:#f0eff8;color:#555}.tab.active{background:var(--purple);color:#fff}.audio{display:grid;gap:12px}.audio audio{width:100%}.concepts{display:flex;flex-wrap:wrap;gap:8px}.pill{padding:7px 10px;background:#eeeaff;color:#4d35c5;border-radius:999px;font-size:13px}.map{min-height:330px;display:grid;place-items:center;position:relative;overflow:hidden;background:radial-gradient(circle at center,#f4f0ff,transparent 55%)}.map .center{padding:18px 24px;background:var(--purple);color:#fff;border-radius:16px;font-weight:900;z-index:2}.map .node{position:absolute;padding:12px 15px;background:#fff;border:1px solid #ddd7ff;border-radius:13px;box-shadow:var(--shadow);font-size:13px}.n1{top:28px;left:15%}.n2{top:34px;right:15%}.n3{bottom:35px;left:17%}.n4{bottom:32px;right:15%}.flash{min-height:230px;display:grid;place-items:center;text-align:center}.flash h2{font-size:25px}.quiz-option{display:block;width:100%;text-align:left;padding:12px;margin:8px 0;border:1px solid var(--line);background:#fff;border-radius:11px}.quiz-option.selected{border-color:var(--purple);background:#f0edff}.quiz-option.correct{border-color:#18a66b!important;background:#eaf8f1!important;color:#126b48}.quiz-option.wrong{border-color:#d83a56!important;background:#fff0f2!important;color:#a51e39}.quiz-feedback{margin-top:14px;padding:13px 15px;border-radius:13px;font-weight:700}.quiz-feedback.correct{background:#eaf8f1;color:#126b48}.quiz-feedback.wrong{background:#fff0f2;color:#a51e39}
.map-editor{display:grid;grid-template-columns:1fr 300px;gap:16px}
