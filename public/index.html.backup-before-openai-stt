function buildSuggestions(d, extras){
  const suggestions=[];
  const next=d.lessons?.find(l=>!l.completed);
  if(next){
    suggestions.push({icon:"▶️",title:"Continua una lezione",text:`La lezione “${esc(next.title)}” non è ancora completata.`,action:"Continua →",id:next.id,tab:"audio"});
  }
  if((extras?.questions||0)>0){
    suggestions.push({icon:"❓",title:"Allenati con un quiz",text:`Hai ${extras.questions} domanda${extras.questions===1?"":"e"} quiz disponibili.`,action:"Apri quiz →",id:d.lessons?.[0]?.id,tab:"quiz"});
  }
  if((extras?.flashcards||0)>0){
    suggestions.push({icon:"🧠",title:"Ripassa le flashcard",text:`Hai ${extras.flashcards} flashcard disponibili per il ripasso.`,action:"Ripassa →",id:d.lessons?.[0]?.id,tab:"flashcards"});
  }
  if(!suggestions.length){
    suggestions.push({icon:"📝",title:"Crea la tua prima attività",text:"Aggiungi una lezione per iniziare a costruire il tuo percorso di studio.",action:"Nuova lezione →",create:true});
  }
  return suggestions.slice(0,3);
}
