@media(max-width:800px){.map-editor{grid-template-columns:1fr}.map-canvas{min-height:360px}.map-node:nth-of-type(2){left:4%}.map-node:nth-of-type(3){right:4%}.map-node:nth-of-type(4){left:4%}.map-node:nth-of-type(5){right:4%}}

.tutor-box{display:grid;grid-template-columns:1fr 320px;gap:18px}
.tutor-chat{min-height:420px;display:flex;flex-direction:column;gap:12px}
.tutor-msg{padding:13px 15px;border-radius:15px;line-height:1.5;max-width:86%}
