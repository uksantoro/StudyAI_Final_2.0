      });
    }

    const sentences=text
      .replace(/\s+/g," ")
      .split(/(?<=[.!?])\s+/)
      .map(s=>s.trim())
      .filter(s=>s.length>=25);

    const concepts=String(l.concepts||"")
      .split(",")
      .map(x=>x.trim())
      .filter(Boolean);

    const cards=[];

    for(const concept of concepts){
      const sentence=sentences.find(s=>
        s.toLowerCase().includes(concept.toLowerCase())
      );

      if(sentence){
        cards.push({
          question:`Che cosa riguarda ${concept}?`,
          answer:sentence
        });
      }
    }

    for(const sentence of sentences){
      if(cards.length>=5) break;

      const words=sentence.match(/[a-zï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½]{5,}/gi)||[];
      const key=words[0];

      if(!key) continue;

      if(cards.some(c=>c.question.toLowerCase().includes(key.toLowerCase()))){
        continue;
      }

      cards.push({
        question:`Che cosa spiega il materiale su "${key}"?`,
        answer:sentence
      });
    }

    const finalCards=cards.slice(0,5);

    if(!finalCards.length){
      return res.status(400).json({
        error:"Non sono riuscito a generare flashcard dal materiale disponibile."
      });
