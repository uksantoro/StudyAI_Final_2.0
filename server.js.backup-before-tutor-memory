      feature:"FLASHCARDS",
      used:quota.used+1,
      limit:quota.limit,
      remaining:Math.max(0,quota.remaining-1),
      plan:quota.plan
    };

    res.json({
      flashcards:finalCards,
      usage
    });
  }catch(err){
    if(err?.code==="AI_QUOTA_EXCEEDED"){
      return res.status(429).json({
        error:err.message,
        usage:err.quota
      });
    }

    console.error("AI FLASHCARDS ERROR:",err);

