app.put("/api/admin/subscriptions/:id",auth,requireRole("ADMIN","SUPER_ADMIN"),(req,res)=>{
  const subscriptionId=Number(req.params.id);

  if(!Number.isInteger(subscriptionId)){
    return res.status(400).json({error:"ID abbonamento non valido."});
  }

  const current=db.prepare(`
    SELECT *
    FROM subscriptions
    WHERE id=?
  `).get(subscriptionId);

  if(!current){
    return res.status(404).json({error:"Abbonamento non trovato."});
  }

  const {
    plan=current.plan,
    status=current.status,
    expires_at=current.expires_at,
    amount=current.amount,
    auto_renew=current.auto_renew
  }=req.body||{};

  const normalizedPlan=String(plan).toUpperCase();
  const normalizedStatus=String(status).toUpperCase();

  if(!["FREE","PREMIUM"].includes(normalizedPlan)){
    return res.status(400).json({error:"Piano non valido."});
  }

  if(!["ACTIVE","EXPIRED","CANCELLED"].includes(normalizedStatus)){
    return res.status(400).json({error:"Stato non valido."});
  }

  const normalizedAmount=Number(amount);

  if(!Number.isFinite(normalizedAmount)||normalizedAmount<0){
    return res.status(400).json({error:"Importo non valido."});
  }

  const normalizedAutoRenew=auto_renew ? 1 : 0;

  db.prepare(`
    UPDATE subscriptions
    SET
      plan=?,
      status=?,
      expires_at=?,
      amount=?,
      auto_renew=?
    WHERE id=?
  `).run(
    normalizedPlan,
    normalizedStatus,
    expires_at||null,
    normalizedAmount,
    normalizedAutoRenew,
    subscriptionId
  );

  audit(
    req,
    "SUBSCRIPTION_UPDATED",
    `Abbonamento ${subscriptionId} modificato: piano=${normalizedPlan}, stato=${normalizedStatus}, importo=${normalizedAmount}, auto_renew=${normalizedAutoRenew}`
  );

  const updated=db.prepare(`
    SELECT *
    FROM subscriptions
    WHERE id=?
  `).get(subscriptionId);

  res.json(updated);
});
