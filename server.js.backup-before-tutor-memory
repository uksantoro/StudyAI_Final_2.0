    }

    const l=getLessonForUser(id,req.user.id);

    if(!l){
      return res.status(404).json({error:"Lezione non trovata."});
    }

    const text=[
      l.title||"",
      l.summary||"",
      l.transcript||"",
      l.concepts||""
    ].join(" ").trim();

    if(!text){
      return res.status(400).json({
        error:"Inserisci prima una trascrizione, un riassunto o dei concetti."
      });
    }

    const quota=checkAIQuota(req.user.id,"QUIZ",1);

    if(!quota.allowed){
      return res.status(429).json({
        error:quota.reason,
        usage:quota
      });
    }

    const sentences=text
      .replace(/\s+/g," ")
      .split(/(?<=[.!?])\s+/)
      .map(s=>s.trim())
      .filter(s=>s.length>=25);

    const concepts=String(l.concepts||"")
      .split(",")
      .map(x=>x.trim())
      .filter(Boolean);

    const questions=[];

    for(const concept of concepts){
      if(questions.length>=5) break;

      const sentence=sentences.find(s=>
        s.toLowerCase().includes(concept.toLowerCase())
      );

      if(!sentence) continue;

      const distractors=concepts
        .filter(x=>x.toLowerCase()!==concept.toLowerCase())
        .slice(0,3);

      const options=[
        concept,
        ...distractors
      ].slice(0,4);

      while(options.length<2){
        options.push("Nessuna delle precedenti");
      }

      questions.push({
        question:`Quale concetto ï¿½ direttamente collegato al materiale sulla lezione?`,
        options,
        answer_index:0
      });
    }

    for(const sentence of sentences){
      if(questions.length>=5) break;

      const words=sentence.match(/[a-zï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½]{5,}/gi)||[];
      const key=words[0];

      if(!key) continue;

      const duplicate=questions.some(q=>
        q.question.toLowerCase().includes(key.toLowerCase())
      );

      if(duplicate) continue;

      questions.push({
        question:`Quale termine ï¿½ presente nel contenuto della lezione?`,
        options:[key,"lezione","materiale","argomento"],
        answer_index:0
      });
    }

    const finalQuestions=questions.slice(0,5);

    if(!finalQuestions.length){
      return res.status(400).json({
        error:"Non sono riuscito a generare domande dal materiale disponibile."
      });
    }

    const insert=db.prepare(`
      INSERT INTO quiz_questions (lesson_id,question,options,answer_index)
      VALUES (?,?,?,?)
    `);

    const transaction=db.transaction((items)=>{
      for(const q of items){
        insert.run(
          l.id,
          q.question,
          JSON.stringify(q.options),
          q.answer_index
        );
      }
    });

    transaction(finalQuestions);

    recordAIUsage(req.user.id,"QUIZ",1);

    const usage={
      feature:"QUIZ",
      used:quota.used+1,
      limit:quota.limit,
      remaining:Math.max(0,quota.remaining-1),
      plan:quota.plan
    };

    res.json({
      questions:finalQuestions,
      usage
    });
  }catch(err){
    if(err?.code==="AI_QUOTA_EXCEEDED"){
      return res.status(429).json({
        error:err.message,
        usage:err.quota
      });
    }

    console.error("AI QUIZ ERROR:",err);

    res.status(500).json({
      error:"Errore interno del Quiz AI."
    });
  }
});










app.post("/api/ai/analyze-lesson",auth,async(req,res)=>{
  try{
    const { lessonId } = req.body || {};
    const id = Number(lessonId);

    if(!Number.isInteger(id) || id <= 0){
      return res.status(400).json({error:"lessonId non valido."});
    }

    const lesson=getLessonForUser(id,req.user.id);

    if(!lesson){
      return res.status(404).json({error:"Lezione non trovata."});
    }

    const baseUrl=`http://127.0.0.1:${process.env.PORT || 3000}`;
    const authorization=req.headers.authorization || "";

    async function runStep(path){
      const response=await fetch(`${baseUrl}${path}`,{
        method:"POST",
        headers:{
          "Content-Type":"application/json",
          "Authorization":authorization
        },
        body:JSON.stringify({lessonId:id})
      });

      let data={};

      try{
        data=await response.json();
      }catch{}

      if(!response.ok){
        const error=new Error(data.error || `Errore AI su ${path}.`);
        error.status=response.status;
        error.data=data;
        throw error;
      }

      return data;
    }

    const steps=[];

    let current=getLessonForUser(id,req.user.id);

    if(!String(current?.transcript||"").trim()){
      if(!current?.audio_path){
        return res.status(400).json({
          error:"La lezione non contiene ancora una trascrizione nï¿½ un audio da trascrivere."
        });
      }

      await runStep("/api/ai/transcript");
      steps.push("TRANSCRIPT");
      current=getLessonForUser(id,req.user.id);
    }else{
      steps.push("TRANSCRIPT_SKIPPED");
    }

    if(!String(current?.summary||"").trim()){
      await runStep("/api/ai/summary");
      steps.push("SUMMARY");
      current=getLessonForUser(id,req.user.id);
    }else{
      steps.push("SUMMARY_SKIPPED");
    }

    if(!String(current?.concepts||"").trim()){
      await runStep("/api/ai/concepts");
      steps.push("CONCEPTS");
      current=getLessonForUser(id,req.user.id);
    }else{
      steps.push("CONCEPTS_SKIPPED");
    }

    const flashcardCount=db.prepare(
      "SELECT COUNT(*) AS n FROM flashcards WHERE lesson_id=?"
    ).get(id).n;

    if(Number(flashcardCount)===0){
      await runStep("/api/ai/flashcards");
      steps.push("FLASHCARDS");
    }else{
      steps.push("FLASHCARDS_SKIPPED");
    }

    const quizCount=db.prepare(
      "SELECT COUNT(*) AS n FROM quiz_questions WHERE lesson_id=?"
    ).get(id).n;

    if(Number(quizCount)===0){
      await runStep("/api/ai/quiz");
      steps.push("QUIZ");
    }else{
      steps.push("QUIZ_SKIPPED");
    }

    const finalLesson=getLessonForUser(id,req.user.id);

    const finalFlashcards=db.prepare(
      "SELECT COUNT(*) AS n FROM flashcards WHERE lesson_id=?"
    ).get(id).n;

    const finalQuiz=db.prepare(
      "SELECT COUNT(*) AS n FROM quiz_questions WHERE lesson_id=?"
    ).get(id).n;

    res.json({
      ok:true,
      message:"Analisi della lezione completata.",
      result:{
        lessonId:id,
        transcript:!!String(finalLesson?.transcript||"").trim(),
        summary:!!String(finalLesson?.summary||"").trim(),
        concepts:!!String(finalLesson?.concepts||"").trim(),
        flashcards:Number(finalFlashcards),
        quiz:Number(finalQuiz),
        steps
      }
    });

  }catch(err){
    console.error("AI ANALYZE LESSON ERROR:",err);

    if(err?.status){
      return res.status(err.status).json({
        error:err.data?.error || err.message
      });
    }

    res.status(500).json({
      error:"Errore interno nell'analisi della lezione."
    });
  }
});
